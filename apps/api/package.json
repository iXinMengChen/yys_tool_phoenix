{
  "name": "@phoenix/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm db:prepare && prisma generate && nest start --watch",
    "start": "pnpm db:prepare && prisma generate && nest start",
    "start:dev": "pnpm db:prepare && prisma generate && nest start --watch",
    "start:prod": "prisma migrate deploy && node -e \"process.env.NODE_ENV ??= 'production'; require('./dist/main.js')\"",
    "build": "prisma generate && nest build",
    "typecheck": "prisma generate && tsc --noEmit",
    "prisma:generate": "prisma generate",
    "db:prepare": "node ../../scripts/init-database-api.mjs && prisma migrate deploy",
    "db:init": "pnpm db:prepare && prisma generate",
    "import:catalog": "prisma generate && node ../../scripts/import-catalog-api.mjs",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/mapped-types": "*",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/swagger": "^11.4.7",
    "@phoenix/config": "file:../../packages/config",
    "@phoenix/types": "file:../../packages/types",
    "@phoenix/utils": "file:../../packages/utils",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.12",
    "@nestjs/testing": "^12.3.2",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.1",
    "typescript": "^5"
  }
}
