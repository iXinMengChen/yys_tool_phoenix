{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "号来 Phoenix",
  "version": "1.0.0-beta.10",
  "mainBinaryName": "号来 Phoenix",
  "identifier": "com.phoenix.yys.cbg.inspector",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:12832",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "号来 Phoenix",
        "width": 1360,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' data: blob: yys-cbg-assets: http://yys-cbg-assets.localhost",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'self'"
      },
      "devCsp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost ws://127.0.0.1:12832",
        "img-src": "'self' data: blob: yys-cbg-assets: http://yys-cbg-assets.localhost",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'self'"
      }
    }
  },
  "bundle": {
    "resources": {
      "../../../../packages/assets/haolai/*": "static-data/assets/"
    },
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
